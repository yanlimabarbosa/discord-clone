generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  displayName  String
  avatarUrl    String?
  isGuest      Boolean  @default(false)
  username     String?  @unique
  passwordHash String?
  email        String?  @unique
  googleId     String?  @unique
  createdAt    DateTime @default(now())

  memberships    ServerMember[]
  messages       Message[]
  ownedServers   Server[]       @relation("ServerOwner")
  createdInvites Invite[]       @relation("InviteCreator")
  sentFriendReqs Friendship[]   @relation("FriendRequester")
  recvFriendReqs Friendship[]   @relation("FriendAddressee")
  reactions      Reaction[]
  conversations  ConversationParticipant[]
  roleAssignments RoleAssignment[]
}

model Server {
  id        String   @id @default(cuid())
  name      String
  iconUrl   String?
  ownerId   String
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  owner     User     @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    ServerMember[]
  channels   Channel[]
  invites    Invite[]
  categories ChannelCategory[]
  bans       ServerBan[]
  roles      Role[]
}

model Role {
  id          String   @id @default(cuid())
  serverId    String
  name        String
  color       String   @default("#99aab5")
  position    Int      @default(0)
  permissions Int      @default(0)
  createdAt   DateTime @default(now())
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]
}

model RoleAssignment {
  id     String @id @default(cuid())
  roleId String
  userId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId])
}

model ServerMember {
  id       String   @id @default(cuid())
  serverId String
  userId   String
  joinedAt DateTime @default(now())
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}

model ServerBan {
  id       String   @id @default(cuid())
  serverId String
  userId   String
  createdAt DateTime @default(now())
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}

model ChannelCategory {
  id       String    @id @default(cuid())
  serverId String
  name     String
  position Int       @default(0)
  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]
}

model Channel {
  id         String           @id @default(cuid())
  serverId   String
  categoryId String?
  name       String
  icon       String?
  type       ChannelType      @default(TEXT)
  position   Int              @default(0)
  createdAt  DateTime         @default(now())
  server     Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category   ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages   Message[]
}

enum ChannelType {
  TEXT
  VOICE
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  dmKey        String?                   @unique
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String        @id @default(cuid())
  channelId      String?
  conversationId String?
  authorId       String
  content        String
  attachmentUrl  String?
  attachmentType String?
  replyToId      String?
  createdAt      DateTime      @default(now())
  editedAt       DateTime?
  channel        Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo        Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReplies")
  reactions      Reaction[]

  @@index([channelId, createdAt])
  @@index([conversationId, createdAt])
}

model Reaction {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model ReadState {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  @@unique([userId, channelId])
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  serverId    String
  createdById String
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
}

model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}
