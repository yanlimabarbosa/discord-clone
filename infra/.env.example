# Copy to ".env" and fill in.  setup.sh auto-generates secrets on first run.

# Your DuckDNS subdomain (no https://, no trailing slash)
DOMAIN=yourname.duckdns.org

# LiveKit (video). Generate secret with: openssl rand -hex 32
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=CHANGE_ME

# Postgres (defaults are fine for a single box)
POSTGRES_USER=discord
POSTGRES_PASSWORD=discord
POSTGRES_DB=discord

# Auth. JWT_SECRET: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Google OAuth (fill in at Slice 1 — get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
