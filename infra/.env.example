# Copy this file to ".env" and fill in your values.
# On the Oracle box: cp .env.example .env  then edit.

# Your DuckDNS subdomain (no https://, no trailing slash)
DOMAIN=yourname.duckdns.org

# LiveKit credentials. API key can stay "devkey".
# Generate a fresh secret with:  openssl rand -hex 32
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=CHANGE_ME_run_openssl_rand_hex_32
